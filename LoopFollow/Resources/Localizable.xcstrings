    },
    "Alert if BG is equal to or above this value." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KŞ bu değere eşit veya üstündeyse uyar."
          }
        }
      }
    },
    "Alert if BG is equal to or below this value." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KŞ bu değere eşit veya altındaysa uyar."
          }
        }
      }
    },
    "Alert if current IOB or total boluses reach this." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncel IOB veya toplam bolus bu değere ulaşırsa uyar."
          }
        }
      }
    },
    "Alert only if BG is equal to or above this value." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca KŞ bu değere eşit veya üstündeyse uyar."
          }
        }
      }
    },
    "Alert only if BG is equal to or below this value." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca KŞ bu değere eşit veya altındaysa uyar."
          }
        }
      }
    },
    "Alert when Carbs-on-Board is at or above this number." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "COB bu değere eşit veya üstündeyken uyar."
          }
        }
      }
    },
    "Alert when any reading or forecast is at or below this value." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir okuma veya tahmin bu değere eşit veya altındaysa uyar."
          }
        }
      }
    },
    "Alert when recommended bolus is at or above this value." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önerilen bolus bu değere eşit veya üstündeyse uyar."
          }
        }
      }
    },
    "Alerts when BG goes below a limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KŞ bir sınırın altına düştüğünde uyarır."
          }
        }
      }
    },
    "Alerts when BG rises above a limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KŞ bir sınırın üstüne çıktığında uyarır."
          }
        }
      }
    },
    "Alerts when Carbs-on-Board is at or above the amount you set below." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "COB aşağıda belirlediğiniz miktara eşit veya üstünde olduğunda uyarır."
          }
        }
      }
    },
    "Alerts when a future-dated carb entry's scheduled time arrives — a reminder to start eating. Use the max lookahead to ignore fat/protein entries that are typically scheduled further ahead." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İleri tarihli bir karbonhidrat girişinin planlanan saati geldiğinde uyarır — yemeye başlama hatırlatıcısı. Genellikle daha ileriye planlanan yağ/protein girişlerini yok saymak için maksimum ileri bakış süresini kullanın."
          }
        }
      }
    },
    "Alerts when a temp target ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçici hedef sona erdiğinde uyarır."
          }
        }
      }
    },
    "Alerts when a temp target starts." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçici hedef başladığında uyarır."
          }
        }
      }
    },
    "Alerts when an override begins." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Override başladığında uyarır."
          }
        }
      }
    },
    "Alerts when an override ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Override sona erdiğinde uyarır."
          }
        }
      }
    },
    "Alerts when carbs are logged but no bolus is delivered within the delay below.  Allows small-carb / treatment exclusions and pre-bolus detection." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karbonhidrat kaydedilip aşağıdaki gecikme içinde bolus verilmezse uyarır. Küçük karbonhidrat / tedavi istisnalarına ve ön bolus algılamaya izin verir."
          }
        }
      }
    },
    "Alerts when glucose readings drop rapidly. For example, three straight readings each falling by at least the amount you set. Optionally limit alerts to only fire below a certain BG level." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glukoz okumaları hızla düştüğünde uyarır. Örneğin art arda üç okumanın her biri belirlediğiniz miktar kadar düştüğünde. İsteğe bağlı olarak uyarıları yalnızca belirli bir KŞ düzeyinin altında sınırlayabilirsiniz."
          }
        }
      }
    },
    "Alerts when glucose readings rise rapidly. For example, three straight readings each climbing by at least the amount you set.  Optionally limit alerts to only fire above a certain BG." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glukoz okumaları hızla yükseldiğinde uyarır. Örneğin art arda üç okumanın her biri belirlediğiniz miktar kadar yükseldiğinde. İsteğe bağlı olarak uyarıları yalnızca belirli bir KŞ'nin üstünde sınırlayabilirsiniz."
          }
        }
      }
    },
    "Alerts when glucose stays above the limit you set below. Use Persistent if you want to ignore brief spikes." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glukoz aşağıda belirlediğiniz sınırın üstünde kaldığında uyarır. Kısa yükselişleri yok saymak için Kalıcı seçeneğini kullanın."
          }
        }
      }
    },
    "Alerts when insulin-on-board is high, or when several boluses in quick succession exceed the limits you set." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktif insülin yüksek olduğunda ya da art arda verilen birkaç bolus belirlediğiniz sınırları aştığında uyarır."
          }
        }
      }
    },
    "Alerts when no successful loop has occurred for the time you set below." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşağıda belirlediğiniz süre boyunca başarılı bir loop olmadığında uyarır."
          }
        }
      }
    },
    "Alerts when the pump / cannula is within the time window you choose below (relative to the 3-day change limit)." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
