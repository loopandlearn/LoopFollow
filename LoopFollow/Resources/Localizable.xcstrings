      }
    },
    "Ambulatory Glucose Profile (AGP)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambulatuvar Glukoz Profili (AGP)"
          }
