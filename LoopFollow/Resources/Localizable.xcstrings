      }
    },
    "An alert fires once the reservoir is at this value or lower." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezervuar bu değere veya altına indiğinde uyarı verilir."
